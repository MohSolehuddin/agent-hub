# Env untuk agent-hub (dipakai systemd --user). Salin ke .env.hub lalu sesuaikan.
SERVER_URL=https://msytc.my.id
# AGENT_WORKER_TOKEN=          # opsional; kalau diisi HARUS sama dengan server (fail-closed)
AGENT_NAME=agent-hub
AGY_MODELS=gemini-3.7-flash-medium gemini-3.6-flash-medium gemini-3.8-flash-medium
AGY_PRINT_TIMEOUT=15m
DEFAULT_TIMEOUT_MIN=30
POLL_MS=10000
# PORT TIDAK di sini: di-set lewat systemd per-lane (Environment=PORT=4000/4002/4003),
# karena EnvironmentFile meng-override Environment= di systemd.
